# Địa chỉ và khoá công khai (anon / publishable) của dự án Supabase.
# Chạy cục bộ: `npm run supabase:start` rồi `npm run supabase:env` sẽ ghi .env.local giúp.
# Triển khai thật: lấy hai giá trị này ở Project Settings > API trên supabase.com.
# KHÔNG bao giờ đặt khoá service_role ở đây hoặc trong mã chạy trên trình duyệt.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
