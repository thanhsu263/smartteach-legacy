# Địa chỉ và khoá công khai (anon / publishable) của dự án Supabase.
# Chạy cục bộ: `npm run supabase:start` rồi `npm run supabase:env` sẽ ghi .env.local giúp.
# Triển khai thật: lấy hai giá trị này ở Project Settings > API trên supabase.com.
# Không commit khóa thật; không dùng service_role trong mã chạy trên trình duyệt.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chỉ phía server: ghi vào .env.local / secret environment của máy chủ, không dùng NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
APP_BASE_URL=http://localhost:3000
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# AI/RAG chỉ phía server. Xem runbook admin-rag; không đặt giá trị này trong NEXT_PUBLIC_.
# JSON: {"activeVersion":"v1","keys":{"v1":"<base64 của 32 byte ngẫu nhiên>"}}
AI_KEYRING_JSON=
RAG_WORKER_SECRET=
# Optional dedicated secret for exam import; if empty/unset the existing RAG worker secret is used.
# Configure the matching Vault secret plus smartteach_exam_worker_url separately for the target environment.
EXAM_IMPORT_WORKER_SECRET=
